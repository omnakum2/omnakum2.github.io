---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Skills from '../sections/Skills.astro';
import Services from '../sections/Services.astro';
import Tools from '../sections/Tools.astro';
import Projects from '../sections/Projects.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../consts';
import type { SeoConfig } from '../types/seo';
import { faqs } from '../data/portfolio';

const seo: SeoConfig = {
  title: `${SITE.name} | ${SITE.tagline}`,
  description: `${SITE.name} is a ${SITE.tagline} focused on building reliable, high-performance web applications with NestJS, TypeScript and React.js.`,
  canonical: '/',
  jsonLd: {
    faq: faqs,
  },
};
---

<BaseLayout seo={seo}>
  <Hero />
  <About />
  <Skills />
  <Services />
  <CtaBand
    tone="tone-a"
    heading="Need something custom?"
    accentTail=" Let's discuss your requirements."
    icon="tabler:settings-2"
    primaryBtn={{
      text: "Schedule a Consultation",
      href: "#contact",
      icon: "tabler:arrow-right",
    }}
  />
  <Tools />
  <Projects />
  <CtaBand
    tone="tone-b"
    heading="Interested in seeing more"
    accentTail=" or discussing a project?"
    icon="tabler:folder-code"
    primaryBtn={{
      text: "Let's Work Together",
      href: "#contact",
      icon: "tabler:arrow-right",
    }}
    secondaryBtn={{
      text: "More on GitHub",
      href: `${SITE.social.github}?tab=repositories`,
      icon: "tabler:external-link",
      target: "_blank",
      rel: "noopener",
    }}
  />
  <Faq />
  <Contact />
</BaseLayout>
