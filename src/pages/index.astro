---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import TechStack from '../sections/TechStack.astro';
import Services from '../sections/Services.astro';
import Projects from '../sections/Projects.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';
import { SITE } from '../consts';
import type { SeoConfig } from '../types/seo';

const seo: SeoConfig = {
  title: `${SITE.name} — ${SITE.tagline} | Portfolio`,
  description: `${SITE.name} is a ${SITE.tagline} with 5+ years of experience building fast, accessible, and scalable web applications with TypeScript, React, Node.js, and more.`,
  canonical: '/',
};
---

<BaseLayout seo={seo}>
  <Hero />
  <About />
  <TechStack />
  <Services />
  <Projects />
  <Faq />
  <Contact />
</BaseLayout>
