---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Skills from '../sections/Skills.astro';
import Services from '../sections/Services.astro';
import Tools from '../sections/Tools.astro';
import Projects from '../sections/Projects.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';
import { SITE } from '../consts';
import type { SeoConfig } from '../types/seo';
import { faqs } from '../data/portfolio';

const seo: SeoConfig = {
  title: `${SITE.name} | ${SITE.tagline}`,
  description: `${SITE.name} is a ${SITE.tagline} building fast, accessible, and scalable web applications with TypeScript, React, NestJS, and more.`,
  canonical: '/',
  jsonLd: {
    faq: faqs,
  },
};
---

<BaseLayout seo={seo}>
  <Hero />
  <About />
  <Skills />
  <Services />
  <Tools />
  <Projects />
  <Faq />
  <Contact />
</BaseLayout>
