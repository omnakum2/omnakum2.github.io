---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalDoc from '@/components/LegalDoc.astro';
import { privacyPolicy as doc } from '@/data/legal';
import type { SeoConfig } from '@/types/seo';

const seo: SeoConfig = {
  title: 'Privacy Policy',
  description:
    'Learn how Om Nakum handles information submitted through the website and data shared during development projects.',
  canonical: '/privacy-policy/',
};
---

<BaseLayout seo={seo}>
  <LegalDoc doc={doc} />
</BaseLayout>
