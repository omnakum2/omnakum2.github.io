---
import type { TimelineStep } from '../data/experience';

interface Props {
  steps: TimelineStep[];
}
const { steps } = Astro.props;
---

<ol class="relative border-l-2 border-surface-2 pl-8 space-y-10">
  {
    steps.map((step, i) => (
      <li class="relative">
        {/* Timeline dot */}
        <span class="absolute -left-[2.55rem] top-1 flex size-5 items-center justify-center rounded-full border-2 border-brand-primary bg-surface-0">
          <span class="size-2 rounded-full bg-brand-primary" />
        </span>

        <div class="rounded-2xl border border-surface-2 bg-surface-1 p-5 transition hover:border-brand-primary hover:shadow-sm">
          <p class="inline-flex items-center rounded-full bg-brand-primary/10 px-3 py-1 text-xs font-semibold text-brand-primary">
            {step.period}
          </p>
          <h3 class="mt-3 text-lg font-bold text-ink-1">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-2" set:html={step.bodyHtml} />
        </div>
      </li>
    ))
  }
</ol>
