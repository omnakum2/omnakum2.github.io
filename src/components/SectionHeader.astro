---
type AccentColor =
  | 'steel-blue'
  | 'hot-pink'
  | 'sky-blue'
  | 'royal-blue'
  | 'dark-slate-gray';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  /** Background tone the header sits on. Controls text contrast. */
  tone?: 'light' | 'dark';
  /** Color token for the accent tail after the title. */
  accent?: AccentColor;
  /** Character used as the accent tail. Defaults to a period. */
  accentChar?: string;
  /** Optional color token for the eyebrow's em-dash mark. */
  eyebrowAccent?: AccentColor;
}

const {
  eyebrow,
  title,
  intro,
  align = 'left',
  tone = 'light',
  accent = 'steel-blue',
  accentChar = '.',
  eyebrowAccent,
} = Astro.props;

const eyebrowColor = eyebrowAccent ?? accent;

const isDark = tone === 'dark';
const eyebrowText = isDark ? 'text-floral-white/60' : 'text-dark-gray-1/65';
const titleText   = isDark ? 'text-floral-white'    : 'text-dark-gray-1';
const introText   = isDark ? 'text-floral-white/70' : 'text-dark-gray-1/70';
---

<header
  class:list={['mb-12 sm:mb-16', align === 'center' && 'text-center']}
  data-reveal-stagger
>
  {eyebrow && (
    <p
      data-reveal
      class:list={[
        'type-caption-12 mb-5 inline-flex items-baseline gap-2 uppercase tracking-[0.18em]',
        eyebrowText,
      ]}
    >
      <span aria-hidden="true" style={`color: var(--color-${eyebrowColor});`}>—</span>
      {eyebrow}
    </p>
  )}

  <h2
    data-reveal
    class:list={['type-h2-48', titleText]}
  >
    {title}<span aria-hidden="true" style={`color: var(--color-${accent});`}>{accentChar}</span>
  </h2>

  {intro && (
    <p
      data-reveal
      class:list={[
        'type-large-body mt-5 max-w-2xl',
        introText,
        align === 'center' && 'mx-auto',
      ]}
    >
      {intro}
    </p>
  )}
</header>
