---
import { Icon } from 'astro-icon/components';
import { SITE } from '../consts';

const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#faq', label: 'FAQs' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-dark-gray-1/10 bg-floral-white/80 backdrop-blur-lg">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="type-link-20 flex items-center gap-2 text-dark-gray-1">
      <span class="inline-flex size-8 items-center justify-center rounded-full bg-dark-gray-1 text-floral-white type-caption-12">
        {SITE.name.charAt(0)}
      </span>
      {SITE.name}
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-7">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="type-body-15 relative py-1 text-dark-gray-1/70 transition hover:text-dark-gray-1 after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-steel-blue after:transition-all hover:after:w-full"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-dark-gray-1/70 transition hover:text-dark-gray-1"
      aria-label="Toggle menu"
    >
      <Icon name="lucide:menu" class="size-6" />
    </button>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-dark-gray-1/10 bg-floral-white">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="type-body-15 block rounded-lg px-3 py-2.5 text-dark-gray-1/80 transition hover:bg-floral-white-1 hover:text-dark-gray-1"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu?.classList.add('hidden'))
  );
</script>
