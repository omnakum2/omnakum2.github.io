---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

// `id` is the in-page anchor (used by scroll-spy querySelector); the link href
// is prefixed with "/" so it also works from other routes (privacy / terms).
const navItems = [
  { id: "#home", label: "Home" },
  { id: "#about", label: "About" },
  { id: "#skills", label: "Skills" },
  { id: "#services", label: "Services" },
  { id: "#projects", label: "Projects" },
  { id: "#faq", label: "FAQ" },
  { id: "#contact", label: "Contact" },
];
---

<!-- Reading-progress hairline — driven by motion.ts via #scroll-progress -->
<div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

<header
  class="fixed top-0 left-0 right-0 z-50 bg-ground/80 backdrop-blur-md border-b border-ink/10"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="font-heading font-bold text-xl text-accent hover:text-accent-bright transition-colors"
      >
        {SITE.name}
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-baseline gap-1" aria-label="Primary">
        {
          navItems.map((item) => (
            <a
              href={`/${item.id}`}
              data-nav={item.id}
              class="px-3 py-2 rounded-md text-sm font-medium transition-colors text-ink hover:text-accent hover:bg-accent/5"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Mobile toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 -mr-2 rounded-md text-ink hover:text-accent hover:bg-accent/5 transition-colors press"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="tabler:menu-2" class="size-6" data-menu-open />
        <Icon name="tabler:x" class="size-6 hidden" data-menu-close />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-ink/10 bg-surface/95 backdrop-blur-md"
    aria-label="Mobile"
  >
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-3 space-y-1">
      {
        navItems.map((item) => (
          <a
            href={`/${item.id}`}
            class="block px-3 py-3 rounded-md text-base font-medium text-ink hover:text-accent hover:bg-accent/5 transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  import "../scripts/header.ts";
</script>
