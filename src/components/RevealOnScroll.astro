---
interface Props {
  variant?: 'up' | 'fade' | 'scale';
  delay?: number;
  as?: string;
  class?: string;
}

const { variant = 'up', delay, as = 'div', class: className } = Astro.props;
const Tag = as as any;
const style = delay ? `--reveal-delay:${delay}ms` : undefined;
const dataReveal = variant === 'up' ? '' : variant;
---

<Tag data-reveal={dataReveal} style={style} class={className}>
  <slot />
</Tag>
