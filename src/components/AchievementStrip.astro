---
import { Icon } from 'astro-icon/components';
import type { Stat } from '../data/achievements';

interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    stats.map((stat) => (
      <li class="group rounded-2xl border border-surface-2 bg-surface-0 p-6 text-center transition-all duration-300 hover:border-brand-primary hover:shadow-lg hover:shadow-brand-primary/5 hover:-translate-y-1">
        {stat.icon && (
          <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-brand-primary/10 transition group-hover:bg-brand-primary group-hover:text-white">
            <Icon name={stat.icon} class="size-6 text-brand-primary group-hover:text-white transition" />
          </div>
        )}
        <p class="mt-4 text-4xl font-extrabold tracking-tight text-ink-1">
          {stat.value}
          <span class="text-brand-primary">{stat.unit}</span>
        </p>
        <p class="mt-1 text-sm font-medium text-ink-2">{stat.label}</p>
      </li>
    ))
  }
</ul>
