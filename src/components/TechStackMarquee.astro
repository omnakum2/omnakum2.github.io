---
import { Icon } from "astro-icon/components";
import type { TechLogo } from "../data/portfolio";

interface Props {
  logos: TechLogo[];
  /** Animation duration. Lower = faster. */
  durationSeconds?: number;
  /** Scroll direction. */
  direction?: "left" | "right";
}

const { logos, durationSeconds = 45, direction = "left" } = Astro.props;

// Duplicate logos so the looped scroll has seamless content on both ends.
const belt = [...logos, ...logos];
---

<div
  class:list={["marquee group", direction === "right" && "is-reverse"]}
  style={`--duration:${durationSeconds}s;`}
  aria-label="Additional technologies"
>
  <ul class="marquee-track">
    {
      belt.map((logo, i) => (
        <li
          class="belt-item"
          style={`--brand:${logo.color};`}
          aria-hidden={i >= logos.length ? "true" : undefined}
        >
          {/* Role/label live on the icon (the image), so the <li> stays a
              real listitem and the <ul> keeps valid list semantics. */}
          <Icon name={logo.icon} class="belt-icon" role="img" aria-label={logo.name} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    /* Soft fade on both edges so items don't pop in/out */
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 2.5rem;
    padding: 1.5rem 0;
    margin: 0;
    list-style: none;
    animation: marquee-scroll var(--duration) linear infinite;
    will-change: transform;
  }

  .is-reverse .marquee-track {
    animation-direction: reverse;
  }

  /* Pause the whole row when hovering anywhere in the strip,
     so you can mouse to a specific icon without it sliding away. */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Icon only — no border, no background box, generous horizontal breathing room */
  .belt-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 2rem;
  }

  .belt-item :global(svg) {
    width: clamp(3rem, 5vw, 4rem);
    height: clamp(3rem, 5vw, 4rem);
    color: var(--color-muted);
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      color 0.35s ease,
      filter 0.35s ease,
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .belt-item:hover :global(svg) {
    color: var(--brand);
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .belt-item :global(svg) {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
