---
import { SEO } from 'astro-seo';
import { buildSeo } from '../lib/seo';
import type { SeoConfig } from '../types/seo';
import SchemaOrg from './SchemaOrg.astro';
import { buildFaqLd } from '../lib/schema';
import { SITE } from '../consts';

interface Props {
  seo: SeoConfig;
}
const { seo } = Astro.props;
const resolved = buildSeo(seo);
const imageAlt = `${SITE.name} — ${SITE.tagline}`;

const pageScoped = resolved.jsonLd?.faq?.length
  ? [buildFaqLd(resolved.jsonLd.faq)]
  : [];
---

{/* All meta comes from astro-seo's native props (no hand-written meta array). */}
<SEO
  title={resolved.fullTitle}
  description={resolved.description}
  canonical={resolved.canonical}
  noindex={resolved.noindex}
  openGraph={{
    basic: {
      title: resolved.ogTitle,
      type: 'website',
      image: resolved.ogImage,
      url: resolved.canonical,
    },
    optional: {
      description: resolved.ogDescription,
      siteName: SITE.name,
      locale: 'en_US',
    },
    image: {
      alt: imageAlt,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: resolved.ogTitle,
    description: resolved.ogDescription,
    image: resolved.ogImage,
    imageAlt: imageAlt,
  }}
/>

{pageScoped.length > 0 && <SchemaOrg schemas={pageScoped} />}
