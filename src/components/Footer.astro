---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="surface-deep relative overflow-hidden border-t border-pale-sage/15">
  <div class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
      <p class="type-caption-12 uppercase tracking-[0.2em] text-pale-sage/55">© {year} · <span class="text-sage-green">{SITE.name}.</span> All rights reserved.</p>
      <p class="type-caption-12 uppercase tracking-[0.2em] text-pale-sage/40">
        <a class="hover:text-sage-green" href="/privacy-policy">Privacy Policy</a> ·
        <a class="hover:text-sage-green" href="/terms-of-service">Terms of Service</a>
      </p>
    </div>
  </div>
</footer>
