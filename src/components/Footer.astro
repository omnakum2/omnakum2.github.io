---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

const year = new Date().getFullYear();
---

<!-- Floating back-to-top, wired by motion.ts via #back-to-top (do not re-wire) -->
<button
  id="back-to-top"
  type="button"
  class="back-to-top press"
  aria-label="Back to top"
>
  <Icon name="tabler:arrow-up" class="size-5" />
</button>

<footer class="bg-ground-deep border-t border-ink/10">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 py-12">
    <div class="grid gap-8 md:grid-cols-3 items-center">
      <!-- Brand -->
      <div class="text-center md:text-left">
        <h3 class="font-heading font-bold text-xl text-accent mb-1">
          {SITE.name}
        </h3>
        <p class="text-muted text-sm">{SITE.tagline}</p>
      </div>

      <!-- Social -->
      <div class="flex justify-center gap-4">
        <a
          href={`mailto:${SITE.email}`}
          aria-label="Email"
          class="w-10 h-10 rounded-lg bg-surface grid place-items-center text-ink hover:bg-accent hover:text-accent-ink transition-colors press"
        >
          <Icon name="tabler:mail" class="size-5" />
        </a>
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="w-10 h-10 rounded-lg bg-surface grid place-items-center text-ink hover:bg-accent hover:text-accent-ink transition-colors press"
        >
          <Icon name="tabler:brand-github" class="size-5" />
        </a>
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="w-10 h-10 rounded-lg bg-surface grid place-items-center text-ink hover:bg-accent hover:text-accent-ink transition-colors press"
        >
          <Icon name="tabler:brand-linkedin" class="size-5" />
        </a>
      </div>

      <!-- Legal links -->
      <div
        class="flex justify-center md:justify-end gap-2 text-sm text-muted"
      >
        <a href="/privacy-policy/" class="hover:text-accent transition-colors"
          >Privacy Policy</a
        >
        <span aria-hidden="true">·</span>
        <a
          href="/terms-of-service/"
          class="hover:text-accent transition-colors">Terms of Service</a
        >
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-ink/10 mt-8 pt-8 text-center">
      <p class="text-muted text-sm">
        © {year} {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
