---
import { Icon } from 'astro-icon/components';
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="surface-deep relative overflow-hidden border-t border-[rgba(202,210,197,0.15)]">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid items-end gap-10 border-b border-[rgba(202,210,197,0.12)] pb-10 sm:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow-rule text-[#84a98c]">Colophon</p>
        <p class="display-serif mt-4 text-[clamp(28px,4vw,52px)] text-[#f1f4ee] max-w-xl">
          Designed, built & shipped
          <span class="italic font-light" style="color:#cad2c5;">with intent.</span>
        </p>
      </div>
      <ul class="flex items-center gap-2">
        <li>
          <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
            class="inline-flex size-10 items-center justify-center border border-[rgba(202,210,197,0.15)] text-[#cad2c5]/75 transition hover:border-[#84a98c] hover:bg-[#84a98c] hover:text-[#2f3e46]">
            <Icon name="simple-icons:github" class="size-4" />
          </a>
        </li>
        <li>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
            class="inline-flex size-10 items-center justify-center border border-[rgba(202,210,197,0.15)] text-[#cad2c5]/75 transition hover:border-[#84a98c] hover:bg-[#84a98c] hover:text-[#2f3e46]">
            <Icon name="simple-icons:linkedin" class="size-4" />
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
      <p class="type-caption-12 uppercase tracking-[0.2em] text-[#cad2c5]/55">© {year} · {SITE.name}</p>
      <p class="type-caption-12 uppercase tracking-[0.2em] text-[#cad2c5]/40">Sora · Manrope · Sage</p>
    </div>
  </div>
</footer>
