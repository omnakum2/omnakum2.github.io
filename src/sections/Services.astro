---
import { Icon } from "astro-icon/components";
import SectionHeader from "../components/SectionHeader.astro";
import { services } from "../data/portfolio";
---

<section id="services" class="section-band tone-b">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <SectionHeader title="My" accent="Services" subtitle="Comprehensive solutions tailored to your digital needs" />

    <!-- Services grid: 3-in-a-row on desktop, stacked on mobile -->
    <div class="grid gap-6 md:grid-cols-3 items-start max-w-6xl mx-auto" data-reveal-stagger>
      {
        services.map((service) => (
          <article
            data-reveal
            class="group card p-6 transition-all hover:border-ink/15"
          >
            {/* Icon effect: tile fills accent, icon flips to accent-ink, slight scale + rotate */}
            <div class="size-14 rounded-xl bg-accent/10 grid place-items-center transition-all duration-300 group-hover:bg-accent group-hover:scale-105 group-hover:-rotate-3">
              <Icon
                name={service.icon}
                class="size-7 text-accent transition-colors group-hover:text-accent-ink"
              />
            </div>

            <h3 class="font-heading text-xl font-semibold text-accent mt-4">
              {service.title}
            </h3>

            <p class="text-ink-dim leading-relaxed mt-2">
              {service.description}
            </p>

            {/* Reveal-on-hover "What's Included" bullets (grid-rows collapse; visible on touch) */}
            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:grid-rows-[1fr] group-focus-within:grid-rows-[1fr] motion-reduce:transition-none [@media(hover:none)]:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="pt-4 mt-4 border-t border-ink/10">
                  <p class="font-mono text-xs uppercase tracking-wider text-muted mb-3">
                    What's included
                  </p>
                  <ul class="grid gap-2">
                    {service.features.map((feature) => (
                      <li class="flex items-center gap-2 text-sm text-ink-dim">
                        <Icon
                          name="tabler:check"
                          class="size-4 text-accent shrink-0"
                        />
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="text-center mt-14" data-reveal>
      <p class="text-muted mb-5">
        Need something custom? Let's discuss your requirements.
      </p>
      <a class="btn btn-outline" href="#contact">
        Schedule a Consultation
        <Icon name="tabler:arrow-right" class="size-5" />
      </a>
    </div>
  </div>
</section>
