---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

const RESUME_URL = "https://example.com/demo-resume.pdf";
const MASCOT_SRC = "/mascots/hero_mascot.webp";
---

<section
  id="hero"
  class="surface-deep relative flex min-h-screen items-center overflow-hidden"
>
  <!-- Grid backdrop reused from services -->
  <div class="pointer-events-none absolute inset-0 bg-line-grid"></div>

  <div class="relative mx-auto w-full max-w-7xl px-6 py-20 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Text column -->
      <div class="lg:col-span-8" data-reveal-stagger>
        <p data-reveal class="eyebrow-rule mb-6 text-sage-green">
          Available for freelance
        </p>

        <h1
          data-reveal
          class="display-serif text-[clamp(40px,5vw,84px)] leading-[0.9] text-cream-white"
        >
          Hey I'm
          <span class="text-sage-green">
            {SITE.name.split(" ")[0]}
          </span>
        </h1>

        <div
          data-reveal
          class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-[1fr_auto] sm:items-end"
        >
          <p class="type-large-body text-pale-sage/80">{SITE.bio}</p>
        </div>

        <div data-reveal class="mt-12 flex flex-wrap items-center gap-4">
          <a
            href={RESUME_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-none border border-pale-sage bg-pale-sage px-7 py-4 text-charcoal-ink transition-all duration-300 hover:bg-sage-green hover:border-sage-green"
          >
            <span class="type-link-16">View Résumé</span>
            <Icon
              name="tabler:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
          <a
            href="#projects"
            class="group inline-flex items-center gap-2 px-5 py-4 text-cream-white transition-colors duration-300 hover:text-sage-green"
          >
            <span class="type-link-16">View Work</span>
            <Icon
              name="tabler:arrow-right"
              class="size-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>

      <!-- Mascot column -->
      <div
        class="lg:col-span-4"
        data-reveal="scale"
        style="--reveal-delay:200ms"
      >
        <figure class="relative mx-auto w-full max-w-[320px] lg:ml-auto">
          <!-- Mascot Image without Card Frame -->
          <img
            src={MASCOT_SRC}
            alt="Hero mascot"
            width="420"
            height="520"
            loading="eager"
            decoding="async"
            class="relative z-10 h-auto w-full select-none"
          />

          <!-- Desktop Floating Pills -->
          <div
            class="pointer-events-none absolute inset-0 z-20 hidden lg:block"
          >
            <!-- Left Side Pills -->
            <div
              class="absolute -left-[25%] top-[15%] floating-pill floating-pill-delay-1"
            >
              <Icon name="tabler:brand-react" class="size-4 text-[#61DAFB]" /> React
            </div>
            <div
              class="absolute -left-[35%] top-[45%] floating-pill floating-pill-delay-2"
            >
              <Icon name="tabler:server" class="size-4 text-sage-green" /> Full Stack
            </div>
            <div
              class="absolute -left-[15%] top-[75%] floating-pill floating-pill-delay-3"
            >
              <Icon name="tabler:cloud" class="size-4 text-pale-sage" /> Cloud
            </div>

            <!-- Right Side Pills -->
            <div
              class="absolute -right-[25%] top-[20%] floating-pill floating-pill-delay-2"
            >
              <Icon name="tabler:rocket" class="size-4 text-sage-green" /> Astro
            </div>
            <div
              class="absolute -right-[15%] top-[50%] floating-pill floating-pill-delay-3"
            >
              <Icon name="tabler:brain" class="size-4 text-purple-400" /> AI
            </div>
            <div
              class="absolute -right-[30%] top-[80%] floating-pill floating-pill-delay-1"
            >
              <Icon name="tabler:git-branch" class="size-4 text-pale-sage" /> Open
              Source
            </div>
          </div>
        </figure>

        <!-- Mobile Floating Pills -->
        <div class="mt-8 flex flex-wrap justify-center gap-3 lg:hidden">
          <div class="floating-pill floating-pill-delay-1">
            <Icon name="tabler:brand-react" class="size-4 text-[#61DAFB]" /> React
          </div>
          <div class="floating-pill floating-pill-delay-2">
            <Icon name="tabler:server" class="size-4 text-sage-green" /> Full Stack
          </div>
          <div class="floating-pill floating-pill-delay-3">
            <Icon name="tabler:rocket" class="size-4 text-sage-green" /> Astro
          </div>
          <div class="floating-pill floating-pill-delay-2">
            <Icon name="tabler:cloud" class="size-4 text-pale-sage" /> Cloud
          </div>
          <div class="floating-pill floating-pill-delay-3">
            <Icon name="tabler:brain" class="size-4 text-purple-400" /> AI
          </div>
          <div class="floating-pill floating-pill-delay-1">
            <Icon name="tabler:git-branch" class="size-4 text-pale-sage" /> Open Source
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
