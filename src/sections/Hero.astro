---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

const skillTags = [
  // { label: "Vibe coding", icon: "simple-icons:sparkles" },
  { label: "Open Source", icon: "tabler:git-branch" },
  // { label: "Hackathons", icon: "tabler:zap" },
];

const RESUME_URL = "https://example.com/demo-resume.pdf";
const WOP_URL = "https://example.com/wall-of-portfolios";
const MASCOT_SRC = "/mascots/hero_mascot.webp";
---

<section id="hero" class="surface-deep relative overflow-hidden">
  <!-- Editorial type backdrop: oversized faded word, no glowy orbs -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-10 left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-[var(--font-crimson-pro)] font-black uppercase tracking-tighter"
    style="font-size: clamp(180px, 28vw, 420px); line-height: 0.8; color: rgba(202,210,197,0.05); letter-spacing: -0.06em;"
    >FULLSTACK</span
  >

  <div
    class="relative mx-auto max-w-7xl px-6 pt-32 pb-24 sm:pt-40 sm:pb-32 lg:pt-48 lg:pb-40"
  >
    <div class="grid items-start gap-12 lg:grid-cols-12">
      <!-- Text column -->
      <div class="lg:col-span-7" data-reveal-stagger>
        <p data-reveal class="eyebrow-rule mb-6 text-[#84a98c]">
          Independent designer · engineer
        </p>

        <h1
          data-reveal
          class="display-serif text-[clamp(56px,9vw,128px)] text-[#f1f4ee]"
        >
          {SITE.name.split(" ")[0]},
          <span class="block italic font-light" style="color:#cad2c5;"
            >building</span
          >
          <span class="block">
            <span class="relative inline-block">
              <span style="color:#84a98c;">premium</span>
              <span
                class="absolute -bottom-2 left-0 right-0 h-[6px]"
                style="background:#84a98c; opacity:0.35;"></span>
            </span>
            digital
          </span>
          <span class="block italic font-light" style="color:#cad2c5;"
            >products.</span
          >
        </h1>

        <div
          data-reveal
          class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-[1fr_auto] sm:items-end"
        >
          <p class="type-large-body text-[#cad2c5]/80">{SITE.bio}</p>
        </div>

        <div data-reveal class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={RESUME_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-none border border-[#cad2c5] bg-[#cad2c5] px-7 py-4 text-[#2f3e46] transition-all duration-300 hover:bg-[#84a98c] hover:border-[#84a98c]"
          >
            <span class="type-link-16">View Résumé</span>
            <Icon
              name="tabler:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
          <a
            href={WOP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 px-2 py-4 text-[#cad2c5]/85 transition hover:text-[#cad2c5]"
          >
            <span class="size-1.5 rounded-full bg-[#84a98c]"></span>
            <span class="type-link-16">Featured on Wall of Portfolios</span>
            <Icon
              name="tabler:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>

        <ul
          data-reveal
          class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-[rgba(202,210,197,0.10)] pt-6"
        >
          {
            skillTags.map((t) => (
              <li class="type-caption-12 inline-flex items-center gap-2 uppercase tracking-[0.2em] text-[#cad2c5]/65">
                <Icon name={t.icon} class="size-3.5 text-[#84a98c]" />
                {t.label}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mascot column — framed editorial card, no glow disc -->
      <div
        class="lg:col-span-5"
        data-reveal="scale"
        style="--reveal-delay:200ms"
      >
        <figure class="relative">
          <!-- Image frame with strong border, flat sage backdrop -->
          <div
            class="relative aspect-[4/5] overflow-hidden border border-[rgba(202,210,197,0.20)]"
            style="background: linear-gradient(180deg, #3f5d61 0%, #2f3e46 100%);"
          >
            <!-- Grid texture inside frame -->
            <div
              class="pointer-events-none absolute inset-0 opacity-40"
              style="background-image: linear-gradient(rgba(202,210,197,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(202,210,197,0.08) 1px, transparent 1px); background-size: 28px 28px;"
            >
            </div>

            <!-- Corner ticks -->
            <span
              class="absolute left-3 top-3 h-3 w-3 border-l border-t border-[#cad2c5]/70"
            ></span>
            <span
              class="absolute right-3 top-3 h-3 w-3 border-r border-t border-[#cad2c5]/70"
            ></span>
            <span
              class="absolute left-3 bottom-3 h-3 w-3 border-l border-b border-[#cad2c5]/70"
            ></span>
            <span
              class="absolute right-3 bottom-3 h-3 w-3 border-r border-b border-[#cad2c5]/70"
            ></span>

            <div class="absolute inset-0 flex items-end justify-center">
              <img
                src={MASCOT_SRC}
                alt="Hero mascot"
                width="420"
                height="520"
                loading="eager"
                decoding="async"
                class="relative h-[88%] w-auto select-none"
              />
            </div>

            <!-- Caption strip -->
            <div
              class="absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-[rgba(202,210,197,0.18)] bg-[#2f3e46]/80 px-4 py-2.5 backdrop-blur-sm"
            >
              <span
                class="type-caption-12 uppercase tracking-[0.18em] text-[#cad2c5]/80"
                >Crafting · Shipping</span
              >
              <span class="type-caption-12 text-[#84a98c]"
                >© {new Date().getFullYear()}</span
              >
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>
