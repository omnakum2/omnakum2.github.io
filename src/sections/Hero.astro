---
import { Icon } from 'astro-icon/components';
import { SITE } from '../consts';
import TagPill from '../components/TagPill.astro';

const skillTags = [
  { label: 'Vibe coding', icon: 'lucide:sparkles' },
  { label: 'Open Source', icon: 'lucide:git-branch' },
  { label: 'Hackathons', icon: 'lucide:zap' },
];

const RESUME_URL = 'https://example.com/demo-resume.pdf';
const WOP_URL = 'https://example.com/wall-of-portfolios';

const MASCOT_SRC = '/mascots/hero_mascot.webp';
---

<section id="hero" class="section-warm-0 relative overflow-hidden">
  <!-- Real grid-line backdrop -->
  <div
    class="bg-line-grid pointer-events-none absolute inset-0"
    style="--grid-line: rgba(30,28,27,0.07); --grid-size: 72px;"
  ></div>

  <div class="relative mx-auto max-w-6xl px-6 pt-24 pb-20 sm:pt-32 sm:pb-28 lg:pt-40 lg:pb-32">
    <div class="grid items-center gap-16 lg:grid-cols-12">
      <!-- Text column -->
      <div class="lg:col-span-7" data-reveal-stagger>
        <div data-reveal>
          <span class="type-caption-12 inline-flex items-center gap-2 rounded-full border border-dark-gray-1/15 bg-floral-white-1 px-3 py-1.5 text-dark-slate-gray">
            <span class="size-1.5 rounded-full bg-steel-blue"></span>
            Available for new work
          </span>
        </div>

        <h1 data-reveal class="type-h1 mt-6 text-dark-gray-1">
          Yo! I'm
          <span class="text-steel-blue italic">{SITE.name.split(' ')[0]}</span>
          <span aria-hidden="true" class="text-hot-pink">.</span>
        </h1>

        <p data-reveal class="type-large-body mt-6 max-w-xl text-dark-gray-1/75">
          {SITE.bio}
        </p>

        <ul data-reveal class="mt-7 flex flex-wrap gap-2">
          {skillTags.map((t) => (
            <li>
              <TagPill label={t.label} icon={t.icon} variant="neutral" />
            </li>
          ))}
        </ul>

        <div data-reveal class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href={RESUME_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="type-link-20 group inline-flex items-center gap-2 rounded-full bg-dark-gray-1 px-6 py-3.5 text-floral-white transition-transform hover:-translate-y-0.5"
          >
            <Icon name="lucide:file-text" class="size-5" />
            View Resume
            <Icon name="lucide:arrow-up-right" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>

          <a
            href={WOP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="type-link-16 group inline-flex items-center gap-2 rounded-full border border-dark-gray-1/15 bg-floral-white-1 px-5 py-3 text-dark-gray-1 transition-colors hover:border-steel-blue hover:text-steel-blue"
          >
            <Icon name="lucide:badge-check" class="size-4 text-steel-blue" />
            Featured on Wall of Portfolios
          </a>
        </div>
      </div>

      <!-- Mascot column -->
      <div class="lg:col-span-5 flex justify-center" data-reveal="scale" style="--reveal-delay:200ms">
        <div class="relative">
          <img
            src={MASCOT_SRC}
            alt="Hero mascot"
            width="420"
            height="420"
            loading="eager"
            decoding="async"
            class="relative w-72 sm:w-80 lg:w-96 h-auto select-none"
          />
        </div>
      </div>
    </div>
  </div>
</section>
