---
import { Icon } from 'astro-icon/components';
import { hero } from '../data/portfolio';
import { SITE } from '../consts';

const initials = SITE.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<section id="home" class="relative pt-28 pb-16 lg:min-h-screen lg:flex lg:items-center lg:pt-16 lg:pb-0">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 w-full">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
      <!-- ── LEFT column (LCP area) ─────────────────────────────── -->
      <div class="animate-fade-in">
        <!-- Availability pill -->
        <span
          class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-surface px-3.5 py-1.5 font-mono text-xs text-ink-dim"
        >
          <span class="relative flex size-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
          </span>
          {hero.availability}
        </span>

        <!-- Headline: fixed lead + rotating tail -->
        <h1 class="font-heading text-4xl md:text-6xl font-bold text-ink leading-[1.1] mt-5 mb-4">
          {hero.headline.lead}{' '}
          <span class="role-rotate">
            {hero.headline.tails.map((t, i) => (
              <span
                class:list={["role-rotate-item", "text-accent", i === 0 && "is-first"]}
                style={`animation-delay:${(i * (9 / hero.headline.tails.length)).toFixed(2)}s`}
              >{t}</span>
            ))}
          </span>
        </h1>

        <!-- Tagline -->
        <p class="text-lg md:text-xl text-ink-dim leading-relaxed max-w-xl mb-8">{hero.tagline}</p>

        <!-- CTA -->
        <div class="mb-10">
          <a class="btn btn-primary" href="#projects">
            View Portfolio
            <Icon name="tabler:eye" class="size-5" />
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 sm:flex sm:flex-wrap sm:gap-8">
          {hero.stats.map((s, i) => (
            <div class:list={[i !== 0 && "sm:border-l sm:border-ink/10 sm:pl-8"]}>
              <div class="font-heading text-3xl font-bold text-ink tabular-nums" data-countup>{s.value}</div>
              <div class="text-sm text-accent mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- ── RIGHT column — action card ─────────────────────────── -->
      <div
        id="hero-card"
        data-tilt
        class="card relative overflow-hidden rounded-[22px] border border-ink/15 p-7"
      >
        <!-- Breathing accent halo -->
        <div class="hero-halo" aria-hidden="true"></div>

        <!-- Content -->
        <div class="relative z-10">
          <!-- Top row: avatar + name/tagline -->
          <div class="flex items-center gap-3">
            <span
              class="grid size-11 place-items-center rounded-full border border-accent/40 font-heading font-bold text-accent shrink-0"
              style="background:radial-gradient(circle at 30% 25%, var(--color-surface-2), var(--color-ground-deep))"
            >{initials}</span>
            <span class="flex flex-col">
              <span class="font-heading font-semibold text-lg text-ink">{SITE.name}</span>
              <span class="text-sm text-accent">{SITE.tagline}</span>
            </span>
          </div>

          <!-- Eyebrow -->
          <span class="block mt-4 font-mono text-xs uppercase tracking-[0.14em] text-ink">{hero.card.eyebrow}</span>

          <!-- Heading -->
          <h2 class="font-heading text-2xl font-semibold text-accent mt-2 mb-2">{hero.card.heading}</h2>

          <!-- Body -->
          <p class="text-ink-dim leading-relaxed mb-5">{hero.card.body}</p>

          <!-- Contact CTA -->
          <a class="btn btn-primary btn-full" href="#contact">
            Contact Me
            <Icon name="tabler:mail" class="size-5" />
          </a>

          <!-- Checklist -->
          <ul class="mt-6 border-t border-ink/10 pt-5 grid gap-3">
            {hero.card.points.map((point) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-dim">
                <Icon name="tabler:circle-check" class="size-4 text-accent shrink-0" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Rotating tail aligns left inline after the lead (hero-scoped). */
  .role-rotate-item { justify-self: start; }

  /* Accent halo — subtle, non-interactive, and static (no animation) so the
     hero settles immediately during load, keeping Speed Index low. */
  .hero-halo {
    position: absolute;
    top: -30%;
    right: -25%;
    width: 70%;
    height: 70%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 28%, transparent),
      transparent 70%
    );
    filter: blur(18px);
  }
</style>
