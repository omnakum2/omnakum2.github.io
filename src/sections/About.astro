---
import { Icon } from "astro-icon/components";

const ABOUT_MASCOT_SRC = "/mascots/about_mascot.webp";

const quickFacts = [
  { value: "04", label: "Internships shipped" },
  { value: "20+", label: "Projects launched" },
  { value: "06", label: "Hackathons won" },
];

const interests = [
  "Startups",
  "Hackathons",
  "Internships",
  "Travel",
  "Open Source",
];
---

<section
  id="about"
  class="surface-cream relative overflow-hidden py-28 sm:py-36"
>
  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Editorial header rail -->
    <div
      class="grid items-end gap-8 border-b border-[#2f3e46]/15 pb-10 lg:grid-cols-12"
    >
      <div class="lg:col-span-3" data-reveal>
        <p class="eyebrow-rule text-[#52796f]">Chapter 01</p>
        <p
          class="type-caption-12 mt-2 uppercase tracking-[0.22em] text-[#2f3e46]/55"
        >
          About
        </p>
      </div>
      <h2
        data-reveal
        class="display-serif lg:col-span-9 text-[clamp(40px,6vw,88px)] text-[#2f3e46]"
      >
        A designer-coder who never picked
        <span class="italic font-light" style="color:#52796f;">a side.</span>
      </h2>
    </div>

    <!-- Magazine layout: image left tall, story right, pull-quote band -->
    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <!-- Image column -->
      <div class="lg:col-span-5 lg:row-span-2" data-reveal="scale">
        <figure class="sticky top-28">
          <div class="relative aspect-[4/5] overflow-hidden bg-[#84a98c]">
            <div
              class="pointer-events-none absolute inset-0"
              style="background-image: radial-gradient(rgba(47,62,70,0.10) 1px, transparent 1px); background-size: 16px 16px;"
            >
            </div>
            <div class="absolute inset-0 flex items-end justify-center">
              <img
                src={ABOUT_MASCOT_SRC}
                alt="Mascot"
                width="400"
                height="500"
                loading="lazy"
                decoding="async"
                class="h-[90%] w-auto select-none"
              />
            </div>
            <span
              class="absolute left-4 top-4 type-caption-12 tag-num bg-[#2f3e46] px-2.5 py-1 text-[#cad2c5]"
              >PORTRAIT</span
            >
          </div>
          <figcaption
            class="mt-3 flex items-baseline justify-between text-[#2f3e46]/55"
          >
            <span class="type-caption-12 uppercase tracking-[0.2em]"
              >Fig. 02 — In the wild</span
            >
            <span class="type-caption-12 tag-num">02 / 07</span>
          </figcaption>
        </figure>
      </div>

      <!-- Story column -->
      <div class="lg:col-span-7 space-y-10" data-reveal-stagger>
        <p
          data-reveal
          class="type-large-body text-[#2f3e46]/85 first-letter:float-left first-letter:mr-3 first-letter:font-[var(--font-crimson-pro)] first-letter:text-[88px] first-letter:font-bold first-letter:leading-[0.85] first-letter:text-[#52796f]"
        >
          College kept me curious — half of it spent in classrooms, the other
          half scattered across startups, hackathon halls, and late-night Figma
          files. Somewhere along the way, building products stopped feeling like
          coursework and started feeling like a craft.
        </p>

        <!-- Pull quote -->
        <blockquote data-reveal class="border-l-4 border-[#52796f] pl-6 py-2">
          <p class="display-serif text-[clamp(24px,3vw,40px)] text-[#2f3e46]">
            "I move between code and design without picking a side —
            <span class="italic font-light" style="color:#52796f;"
              >user feel and ship quality, both."</span
            >
          </p>
        </blockquote>

        <p data-reveal class="type-body-17 text-[#2f3e46]/75">
          I care about what users feel when they open a screen, and equally
          about how the same screen ships, scales, and stays maintainable months
          later. Outside work I'm reading short books, traveling on a whim, and
          usually surrounded by a small circle of people who push me to think
          sharper.
        </p>

        <!-- Quick facts — editorial number block, no card -->
        <dl
          data-reveal
          class="grid grid-cols-3 divide-x divide-[#2f3e46]/15 border-y border-[#2f3e46]/15 py-8"
        >
          {
            quickFacts.map((f) => (
              <div class="px-4 first:pl-0 last:pr-0">
                <dt class="display-serif text-[clamp(36px,5vw,64px)] text-[#52796f]">
                  {f.value}
                </dt>
                <dd class="type-caption-12 mt-2 uppercase tracking-[0.2em] text-[#2f3e46]/65">
                  {f.label}
                </dd>
              </div>
            ))
          }
        </dl>

        <!-- Interest tags + CTA inline -->
        <div
          data-reveal
          class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
        >
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {
              interests.map((i) => (
                <li class="type-caption-12 uppercase tracking-[0.2em] text-[#2f3e46]/70">
                  — {i}
                </li>
              ))
            }
          </ul>
          <a
            href="#contact"
            class="group inline-flex items-center gap-3 self-start border-b-2 border-[#2f3e46] pb-1 text-[#2f3e46] transition hover:border-[#52796f] hover:text-[#52796f] sm:self-end"
          >
            <span class="type-link-16">Let's talk</span>
            <Icon
              name="tabler:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
