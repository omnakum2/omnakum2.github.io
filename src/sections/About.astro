---
import { Icon } from "astro-icon/components";

const ABOUT_MASCOT_SRC = "/mascots/about_mascot.webp";

const quickFacts = [
  { value: "04", label: "Internships shipped" },
  { value: "20+", label: "Projects launched" },
  { value: "06", label: "Hackathons won" },
];

const interests = [
  "Hackathons",
  "Internships",
  "Travel",
  "Open Source",
];
---

<section
  id="about"
  class="surface-mid relative overflow-hidden py-28 sm:py-36"
>
  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Editorial header rail -->
     <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal-stagger>
        <p data-reveal class="eyebrow-rule text-near-black/70">Chapter 01 · About</p>
        <h2 data-reveal class="display-serif mt-5 text-[clamp(40px,6vw,88px)] text-near-black">
          A designer-coder who never picked
          <span class="italic font-light text-charcoal-ink">a side.</span>
        </h2>
      </div>
    </div>

    <!-- Magazine layout: image left tall, story right, pull-quote band -->
    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <!-- Image column -->
      <div class="lg:col-span-5 lg:row-span-2" data-reveal="scale">
        <figure class="sticky top-28">
          <div class="relative aspect-[4/5] overflow-hidden bg-pale-sage">
            <div
              class="pointer-events-none absolute inset-0 texture-dots"
            >
            </div>
            <div class="absolute inset-0 flex items-end justify-center">
              <img
                src={ABOUT_MASCOT_SRC}
                alt="Mascot"
                width="400"
                height="500"
                loading="lazy"
                decoding="async"
                class="h-[90%] w-auto select-none"
              />
            </div>
            <span
              class="absolute left-4 top-4 type-caption-12 tag-num bg-charcoal-ink px-2.5 py-1 text-pale-sage"
              >PORTRAIT</span
            >
          </div>
          <figcaption
            class="mt-3 flex items-baseline justify-between text-near-black/60"
          >
            <span class="type-caption-12 uppercase tracking-[0.2em]"
              >Fig. 02 — In the wild</span
            >
            <span class="type-caption-12 tag-num">02 / 07</span>
          </figcaption>
        </figure>
      </div>

      <!-- Story column -->
      <div class="lg:col-span-7 space-y-10" data-reveal-stagger>
        <p
          data-reveal
          class="type-large-body text-near-black/80 first-letter:float-left first-letter:mr-3 first-letter:font-[var(--font-crimson-pro)] first-letter:text-[88px] first-letter:font-bold first-letter:leading-[0.85] first-letter:text-near-black"
        >
          College kept me curious — half of it spent in classrooms, the other
          half scattered across startups, hackathon halls, and late-night Figma
          files. Somewhere along the way, building products stopped feeling like
          coursework and started feeling like a craft.
        </p>

        <!-- Pull quote -->
        <blockquote data-reveal class="border-l-4 border-near-black pl-6 py-2">
          <p class="display-serif text-[clamp(24px,3vw,40px)] text-near-black">
            "I move between code and design without picking a side —
            <span class="italic font-light text-charcoal-ink"
              >user feel and ship quality, both."</span
            >
          </p>
        </blockquote>
        
        <!-- Quick facts — editorial number block, no card -->
        <dl
          data-reveal
          class="grid grid-cols-3 divide-x divide-near-black/20 border-y border-near-black/20 py-8"
        >
          {
            quickFacts.map((f) => (
              <div class="px-4 first:pl-0 last:pr-0">
                <dt class="display-serif text-[clamp(36px,5vw,64px)] text-near-black">
                  {f.value}
                </dt>
                <dd class="type-caption-12 mt-2 uppercase tracking-[0.2em] text-near-black/60">
                  {f.label}
                </dd>
              </div>
            ))
          }
        </dl>

        <!-- Interest tags + CTA inline -->
        <div
          data-reveal
          class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
        >
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {
              interests.map((i) => (
                <li class="type-caption-12 uppercase tracking-[0.2em] text-near-black/70">
                  — {i}
                </li>
              ))
            }
          </ul>
          <a
            href="#contact"
            class="group inline-flex items-center gap-3 self-start border-b-2 border-near-black pb-1 text-near-black transition hover:opacity-75 sm:self-end"
          >
            <span class="type-link-16">Let's talk</span>
            <Icon
              name="tabler:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
