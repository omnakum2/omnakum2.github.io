---
import { Icon } from "astro-icon/components";
import SectionHeader from "../components/SectionHeader.astro";
import { about } from "../data/portfolio";

// Journey Timeline, chronological: education oldest → newest
// (Bachelor's → Master's) first, then the current role LAST.
const eduRank = (t: string): number =>
  t === "undergraduate" ? 0 : t === "postgraduate" ? 1 : 2;

interface TimelineItem {
  icon: string;
  primary: string; // level / position — minimal glance label (white)
  year: string; // year or range — accent
  cardTitle: string; // institution / company
  cardBody: string; // expanded degree full form / role description
}

const exp = about.experience[0];

const timeline: TimelineItem[] = [
  ...[...about.education]
    .sort((a, b) => eduRank(a.type) - eduRank(b.type))
    .map((edu) => ({
      icon: "tabler:school",
      primary: edu.fullForm,
      year: `${edu.year}`,
      cardTitle: edu.level,
      cardBody: edu.institution
    })),
  {
    icon: "tabler:briefcase",
    primary: exp.position,
    year: `${exp.joiningYear} – Present`,
    cardTitle: exp.company,
    cardBody: exp.description
  },
];

// Connector geometry: the 2px line tucks under the first/last node centers,
// so inset each side by half a column.
const n = timeline.length;
const inset = 100 / (n * 2);
const gridStyle = `grid-template-columns:repeat(${n},minmax(0,1fr))`;
const lineStyle = `left:${inset}%;right:${inset}%`;
---

<section id="about" class="section-band tone-b">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <!-- Section header -->
    <SectionHeader title="About" accent="Me" subtitle="Get to know more about my journey, passion, and expertise" />

    <!-- Centered inner column: story card + timeline share this width -->
    <div class="mx-auto max-w-5xl">
      <!-- My Story — full-width card, justified copy. Magnetic tilt +
           cursor-light on hover, matching the hero/bento cards. -->
      <div
        id="story-card"
        data-reveal
        data-tilt="3"
        class="relative overflow-hidden card p-8"
      >
        <div class="relative z-10">
          <h3 class="font-heading text-2xl font-semibold text-ink mb-4">
            My Story
          </h3>
          <p class="text-ink-dim leading-relaxed text-justify">
            {about.bio}
          </p>
        </div>
      </div>

      <!-- Journey Timeline -->
      <h3 class="font-heading text-2xl font-semibold text-ink text-center mt-14 mb-10">
        Journey Timeline
      </h3>

      <!-- Horizontal, hover-to-reveal. Wrapped in a scroll container so narrow
           viewports scroll the row instead of overflowing the page. -->
      <div
        data-reveal
        class="hidden md:block -mx-6 overflow-x-auto px-6 pb-2 sm:mx-0 sm:px-0"
      >
        <div class="relative min-w-[560px] md:min-w-0">
          <!-- 2px connector line running through the node centers (behind) -->
          <span
            class="pointer-events-none absolute top-7 z-0 h-0.5 bg-ink/15"
            style={lineStyle}
            aria-hidden="true"></span>

          <ol
            class="relative m-0 grid list-none snap-x snap-mandatory gap-4 p-0"
            style={gridStyle}
          >
            {
              timeline.map((item) => (
                <li
                  class="group snap-center focus:outline-none"
                  tabindex="0"
                >
                  {/* Node — accent fill appears only on the hovered/focused one */}
                  <div class="relative z-10 flex justify-center">
                    <span class="size-14 rounded-full grid place-items-center transition-colors border border-ink/10 bg-surface-2 text-accent group-hover:bg-accent group-hover:text-accent-ink group-hover:border-accent group-focus-within:bg-accent group-focus-within:text-accent-ink group-focus-within:border-accent">
                      <Icon name={item.icon} class="h-6 w-6" />
                    </span>
                  </div>

                  {/* Always-visible caption — minimal: level (white) + year (accent) */}
                  <div class="mt-4 text-center">
                    <p class="font-body text-ink font-semibold">
                      {item.primary} • <span class="text-sm text-accent">{item.year}</span>
                    </p>
                  </div>

                  {/* Detail card — collapsed by default (just breathing room),
                      expands downward on hover / keyboard focus; always open on
                      touch. Mirrors the Services "What's included" reveal. */}
                  <div class="mt-4 grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:grid-rows-[1fr] group-focus-within:grid-rows-[1fr] motion-reduce:transition-none [@media(hover:none)]:grid-rows-[1fr]">
                    <div class="overflow-hidden">
                      <div class="card p-5">
                        <p class="font-heading text-accent text-sm font-semibold">
                          {item.cardTitle}
                        </p>
                        <p class="text-muted text-sm mt-1 leading-relaxed">
                          {item.cardBody}
                        </p>
                      </div>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <!-- Mobile-only vertical stack — clean cards, no horizontal scroll. -->
      <ol class="md:hidden grid gap-4 list-none m-0 p-0" data-reveal-stagger>
        {timeline.map((item) => (
          <li data-reveal class="card p-6">
            <div class="flex items-center gap-4">
              <span class="size-12 shrink-0 rounded-full grid place-items-center border border-ink/10 bg-surface-2 text-accent">
                <Icon name={item.icon} class="h-6 w-6" />
              </span>
              <div>
                <p class="font-heading text-base font-semibold text-ink">{item.primary}</p>
                <p class="text-sm text-accent">{item.year}</p>
              </div>
            </div>
            <p class="text-sm font-semibold text-ink mt-3">{item.cardTitle}</p>
            <p class="text-sm text-muted mt-1 leading-relaxed">{item.cardBody}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
