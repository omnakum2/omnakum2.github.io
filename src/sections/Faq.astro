---
import { Icon } from "astro-icon/components";
import { faqs } from "../data/faqs";

const FAQ_MASCOT_SRC = "/mascots/faq_mascot.webp";
---

<section id="faq" class="surface-mid relative overflow-hidden py-28 sm:py-36">
  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Editorial header — left-aligned with rule -->
    <div
      class="grid items-end gap-8 border-b border-near-black/20 pb-10 lg:grid-cols-12"
    >
      <div class="lg:col-span-8" data-reveal-stagger>
        <p data-reveal class="eyebrow-rule text-near-black/70">
          Chapter 05 · Frequently Asked Questions
        </p>
        <h2
          data-reveal
          class="display-serif mt-5 text-[clamp(40px,6vw,88px)] text-near-black"
        >
          Answered
          <span class="italic font-light text-charcoal-ink"
            >in plain words.</span
          >
        </h2>
      </div>
    </div>

    <!-- 12-col grid — left index column + accordion -->
    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <ul class="lg:col-span-8 list-none" data-reveal-stagger>
        {
          faqs.map((faq, idx) => (
            <li data-reveal>
              <details class="group/faq border-b border-near-black/20 py-2 transition open:border-charcoal-ink">
                <summary class="flex cursor-pointer items-baseline gap-6 py-6 list-none [&::-webkit-details-marker]:hidden">
                  <span class="type-caption-12 tag-num text-charcoal-ink w-10 shrink-0">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <span class="display-serif flex-1 text-[clamp(22px,2.4vw,32px)] text-near-black">
                    {faq.question}
                  </span>
                  <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-near-black/30 text-near-black/80 transition-all duration-300 group-open/faq:rotate-45 group-open/faq:border-charcoal-ink group-open/faq:bg-charcoal-ink group-open/faq:text-pale-sage">
                    <Icon name="tabler:plus" class="size-4" />
                  </span>
                </summary>
                <div class="grid grid-rows-[0fr] group-open/faq:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
                  <div class="overflow-hidden">
                    <div class="pb-8 pl-[64px] pr-12">
                      <p class="type-body-17 m-0 text-near-black/80 max-w-2xl">
                        {faq.answer}
                      </p>
                    </div>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ul>

      <!-- FAQ Mascot -->
      <div
        class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start space-y-6"
        data-reveal
      >
        <img
          src={FAQ_MASCOT_SRC}
          alt="Mascot pointing at the questions"
          width="180"
          height="180"
          loading="lazy"
          decoding="async"
          class="h-32 w-auto select-none lg:h-44"
        />
      </div>
    </div>
  </div>
</section>
