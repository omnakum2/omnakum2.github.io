---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../components/SectionHeader.astro";
import { projects } from "../data/portfolio";
import { SITE } from "../consts";

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/project-*.webp",
  { eager: true },
);
const resolveImg = (path: string) => {
  const file = path.split("/").pop();
  const hit = Object.entries(projectImages).find(([k]) => k.endsWith("/" + file));
  return hit?.[1].default;
};

/* Two tabs, each a compact crossfade carousel (one horizontal card per view).
 * `icon` doubles as the tab glyph. Only the academic panel shows actions. */
const panels = [
  {
    key: "academic",
    label: "Academic & Personal",
    icon: "tabler:book",
    items: projects.academic,
  },
  {
    key: "company",
    label: "Industry",
    icon: "tabler:building",
    items: projects.company,
  },
] as const;
---

<section id="projects" class="section-band tone-b">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <SectionHeader title="Things I've" accent="Built" subtitle="A showcase of projects that demonstrate my skills and problem-solving" />

    <!-- Compact shell -->
    <div class="mx-auto max-w-4xl" data-reveal>
      <!-- Segmented tab control -->
      <div
        class="grid grid-cols-2 gap-1 rounded-lg bg-ground-deep p-1 max-w-md mx-auto mb-10"
        role="tablist"
        aria-label="Project categories"
      >
        {
          panels.map((panel, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${panel.key}`}
              data-tab={panel.key}
              aria-controls={`panel-${panel.key}`}
              aria-selected={i === 0 ? "true" : "false"}
              class:list={[
                "inline-flex items-center justify-center gap-2 rounded-md px-3 py-2 text-xs sm:text-sm font-semibold whitespace-nowrap transition-colors press",
                i === 0 ? "bg-surface text-accent" : "text-muted",
              ]}
            >
              <Icon
                name={panel.icon}
                data-tab-icon
                class:list={["w-4 h-4", i === 0 ? "text-accent" : ""]}
              />
              {panel.label}
            </button>
          ))
        }
      </div>

      <!-- Tab panels: both in the DOM, inactive one hidden -->
      {
        panels.map((panel, i) => (
          <div
            id={`panel-${panel.key}`}
            role="tabpanel"
            aria-labelledby={`tab-${panel.key}`}
            tabindex="0"
            data-panel={panel.key}
            hidden={i !== 0}
          >
            <div data-carousel>
              <!-- Carousel viewport (relative) with flanking arrows -->
              <div class="relative">
                <!-- Prev arrow: flanks the card, vertically centered -->
                <button
                  type="button"
                  data-prev
                  aria-label="Previous project"
                  class="absolute top-1/2 -translate-y-1/2 left-2 lg:-left-4 z-20 size-9 rounded-full border border-ink/15 bg-surface text-ink hidden lg:grid place-items-center hover:bg-accent hover:text-accent-ink transition-colors press"
                >
                  <Icon name="tabler:chevron-left" class="w-5 h-5" />
                </button>

                <!-- Crossfade viewport: slides stacked in one grid cell -->
                <div class="pgrid" data-swipe>
                  {panel.items.map((p, si) => (
                    <div
                      class:list={["pslide", si === 0 ? "is-active" : ""]}
                      data-slide={si}
                    >
                      <article class="card overflow-hidden md:flex">
                        <div class="md:w-[42%] shrink-0 relative">
                          {(() => {
                            const img = resolveImg(p.image);
                            return img ? (
                              <Image
                                src={img}
                                alt={`${p.name} screenshot`}
                                widths={[400, 800]}
                                sizes="(min-width: 768px) 42vw, 100vw"
                                loading="lazy"
                                class="w-full h-48 md:h-full object-cover"
                              />
                            ) : null;
                          })()}
                          {p.status && (
                            <span class="absolute top-3 right-3 rounded-full bg-accent text-accent-ink text-xs font-semibold px-2.5 py-0.5">
                              {p.status}
                            </span>
                          )}
                        </div>

                        <div class="p-6 md:flex-1">
                          <h3 class="font-heading text-xl font-semibold text-ink">
                            {p.name}
                          </h3>

                          <div class="mt-2 flex flex-wrap gap-2">
                            <span class="inline-flex rounded-full border border-accent/40 text-accent-bright text-xs font-medium px-2.5 py-0.5">
                              {p.category}
                            </span>
                            {p.techStack.map((t) => (
                              <span class="inline-flex rounded-full border border-accent/40 text-accent-bright text-xs font-medium px-2.5 py-0.5">
                                {t}
                              </span>
                            ))}
                          </div>

                          <p class="text-muted text-sm mt-3 leading-relaxed">
                            {p.description}
                          </p>

                          <div class="mt-3 grid gap-1">
                            {p.features.map((feature) => (
                              <div class="flex items-center gap-2 text-sm text-ink-dim">
                                <span class="size-1.5 rounded-full bg-accent shrink-0" />
                                {feature}
                              </div>
                            ))}
                          </div>

                          {panel.key === "academic" && (p.liveDemo || p.sourceCode) && (
                            <div class="mt-5 flex gap-3">
                              {p.liveDemo && (
                                <a
                                  href={p.liveDemo}
                                  target="_blank"
                                  rel="noopener"
                                  class="btn btn-primary btn-full flex-1"
                                >
                                  Live Demo
                                  <Icon name="tabler:external-link" class="w-4 h-4" />
                                </a>
                              )}
                              {p.sourceCode && (
                                <a
                                  href={p.sourceCode}
                                  target="_blank"
                                  rel="noopener"
                                  class="btn btn-outline btn-full flex-1"
                                >
                                  View Code
                                  <Icon name="tabler:brand-github" class="w-4 h-4" />
                                </a>
                              )}
                            </div>
                          )}
                        </div>
                      </article>
                    </div>
                  ))}
                </div>

                <!-- Next arrow: flanks the card, vertically centered -->
                <button
                  type="button"
                  data-next
                  aria-label="Next project"
                  class="absolute top-1/2 -translate-y-1/2 right-2 lg:-right-4 z-20 size-9 rounded-full border border-ink/15 bg-surface text-ink hidden lg:grid place-items-center hover:bg-accent hover:text-accent-ink transition-colors press"
                >
                  <Icon name="tabler:chevron-right" class="w-5 h-5" />
                </button>
              </div>

              <!-- Dots: centered, below the card. Mobile arrows flank the dots. -->
              <div class="mt-6 flex items-center justify-center gap-3" data-dots>
                <!-- Mobile prev arrow: sits in the control row on <lg -->
                <button
                  type="button"
                  data-prev
                  aria-label="Previous project"
                  class="lg:hidden size-11 rounded-full border border-ink/15 bg-surface text-ink grid place-items-center hover:bg-accent hover:text-accent-ink transition-colors press"
                >
                  <Icon name="tabler:chevron-left" class="w-5 h-5" />
                </button>

                {panel.items.map((_, di) => (
                  <button
                    type="button"
                    data-dot={di}
                    aria-label={`Go to project ${di + 1}`}
                    class="grid place-items-center h-11 w-6 press"
                  >
                    {/* Small visual dot; the button itself is the 24x44 tap
                        target. projects-carousel.ts toggles this inner span. */}
                    <span
                      data-dot-visual
                      class:list={[
                        "block rounded-full transition-all",
                        di === 0
                          ? "w-6 h-1.5 bg-accent"
                          : "w-1.5 h-1.5 bg-ink/25",
                      ]}
                    />
                  </button>
                ))}

                <!-- Mobile next arrow: sits in the control row on <lg -->
                <button
                  type="button"
                  data-next
                  aria-label="Next project"
                  class="lg:hidden size-11 rounded-full border border-ink/15 bg-surface text-ink grid place-items-center hover:bg-accent hover:text-accent-ink transition-colors press"
                >
                  <Icon name="tabler:chevron-right" class="w-5 h-5" />
                </button>
              </div>
            </div>
          </div>
        ))
      }

      <!-- CTA -->
      <div class="text-center mt-14">
        <p class="text-muted mb-5">
          Interested in seeing more or discussing a project?
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="btn btn-primary" href="#contact">
            Let's Work Together
            <Icon name="tabler:arrow-right" class="w-5 h-5" />
          </a>
          <a
            class="btn btn-outline"
            href={`${SITE.social.github}?tab=repositories`}
            target="_blank"
            rel="noopener"
          >
            More on GitHub
            <Icon name="tabler:external-link" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pgrid {
    display: grid;
    touch-action: pan-y;
  }
  .pslide {
    grid-area: 1 / 1;
    opacity: 0;
    /* visibility:hidden also removes the slide from the tab order and the
       accessibility tree, so keyboard focus can't reach off-screen slides. */
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s, visibility 0.5s;
  }
  .pslide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  import "../scripts/projects-carousel.ts";
</script>
