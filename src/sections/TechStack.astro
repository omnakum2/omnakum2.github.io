---
import TechStackMarquee from "../components/TechStackMarquee.astro";
import { techStack } from "../data/techStack";

const half = Math.ceil(techStack.length / 2);
const topRow = techStack.slice(0, half);
const bottomRow = techStack.slice(half);

const clusters = [
  {
    kicker: "01",
    title: "Design",
    body: "Systems, motion, prototyping. Figma to handoff in one move.",
  },
  {
    kicker: "02",
    title: "Engineering",
    body: "TypeScript, React, Astro, Node — typed end-to-end.",
  },
  {
    kicker: "03",
    title: "Infrastructure",
    body: "Edge, CDN, observability. Ship-and-sleep posture.",
  },
];
---

<section
  id="skills"
  class="surface-cream relative overflow-hidden py-28 sm:py-36"
>
  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Big editorial heading + capability grid (no badges) -->
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal-stagger>
        <p data-reveal class="eyebrow-rule text-forest-teal">
          Chapter 02 · Capabilities
        </p>
        <h2
          data-reveal
          class="display-serif mt-5 text-[clamp(40px,6vw,88px)] text-charcoal-ink"
        >
          A studio practice in
          <span class="italic font-light text-forest-teal"
            >three movements.</span
          >
        </h2>
      </div>
      <p data-reveal class="lg:col-span-5 type-body-17 text-charcoal-ink/75">
        I run an integrated practice — design, build, ship — so the work stays
        cohesive from first sketch to production deploy.
      </p>
    </div>

    <!-- Capability clusters -->
    <ul
      class="mt-16 overflow-hidden grid gap-px border border-charcoal-ink/10 bg-charcoal-ink/10 sm:grid-cols-3"
      data-reveal-stagger
    >
      {
        clusters.map((c) => (
          <li
            data-reveal
            class="group relative bg-cream-white p-8 transition
             hover:bg-charcoal-ink"
          >
            <div class="flex items-start justify-between">
              <span
                class="type-caption-12 tag-num
                 text-charcoal-ink/70 transition duration-500 group-hover:text-cream-white"
              >
                {c.kicker} /
              </span>

              <span
                class="size-2 rounded-full bg-charcoal-ink transition duration-500
                 group-hover:scale-[1.8] group-hover:bg-cream-white"
              />
            </div>

            <h3
              class="display-serif mt-12 text-[clamp(28px,3vw,44px)]
               text-charcoal-ink transition-colors duration-500
               group-hover:text-cream-white"
            >
              {c.title}
            </h3>

            <p
              class="type-body-15 mt-4 text-charcoal-ink/70
               transition-colors duration-500
               group-hover:text-cream-white/80"
            >
              {c.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="relative mx-auto mt-20 max-w-7xl px-6">
    <div
      data-reveal
      class="flex items-baseline justify-between border-t border-charcoal-ink/15 pt-5"
    >
      <p
        class="type-caption-12 uppercase tracking-[0.22em] text-charcoal-ink/60"
      >
        The toolbox
      </p>
      <p class="type-caption-12 tag-num text-charcoal-ink/45">
        {techStack.length} TOOLS
      </p>
    </div>
  </div>

  <div class="relative mt-6 space-y-3" data-reveal>
    <TechStackMarquee logos={topRow} direction="left" durationSeconds={48} />
    <TechStackMarquee
      logos={bottomRow}
      direction="right"
      durationSeconds={55}
    />
  </div>
</section>
