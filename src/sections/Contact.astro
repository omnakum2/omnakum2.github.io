---
import { Icon } from "astro-icon/components";
import SectionHeader from "../components/SectionHeader.astro";
import { contact } from "../data/portfolio";

const { call } = contact;
const hasBooking =
  typeof call.bookingUrl === "string" && call.bookingUrl.trim() !== "";

const fieldClass =
  "w-full rounded-md bg-ground-deep border border-ink/30 px-4 py-3 text-ink placeholder:text-muted focus:border-accent focus:outline-none transition-colors";
---

<section id="contact" class="section-band tone-b">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <!-- Header -->
    <SectionHeader
      title="Let's"
      accent="Work Together"
      subtitle="Ready to start? Tell me about your project and let's talk."
    />

    <div class="grid lg:grid-cols-2 gap-8 items-start max-w-6xl mx-auto">
      <!-- LEFT: What we'll cover — centered against the taller form so the
           height difference reads as balanced whitespace, not a bottom gap. -->
      <div data-reveal class="card p-8 lg:self-center">
        <h3 class="font-heading text-2xl font-semibold text-ink mb-2">
          What we'll cover on the call
        </h3>
        <p class="text-muted mb-6">
          A quick, no-pressure chat about your idea and the best way to build
          it.
        </p>

        <ul class="space-y-4">
          {
            contact.discussPoints.map((point) => (
              <li class="flex items-start gap-3 text-ink-dim">
                <Icon
                  name="tabler:circle-check"
                  class="size-5 text-accent mt-0.5 shrink-0"
                />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <!-- Availability note -->
        <div class="mt-8 pt-6 border-t border-ink/10">
          <div class="flex items-center gap-2 text-ink mb-2">
            <Icon name="tabler:clock" class="size-5 text-accent shrink-0" />
            <span class="font-medium">Available for remote work</span>
          </div>
          <p class="text-sm text-muted">{contact.availability}</p>
        </div>
      </div>

      <!-- RIGHT: Details form -->
      <div data-reveal class="card p-8">
        <p
          id="step-indicator"
          class="font-mono text-xs uppercase tracking-[0.14em] text-accent-bright mb-3"
        >
          Step 1 of 2
        </p>
        <p id="step-title" class="text-ink-dim mb-6">
          Submit your details to book a free quick intro call.
        </p>

        <form id="contact-form" novalidate class="grid gap-4">
          <div>
            <label for="cf-name" class="block text-sm text-ink-dim mb-1.5"
              >Name</label
            >
            <input
              id="cf-name"
              type="text"
              name="name"
              required
              placeholder="Your name"
              aria-describedby="cf-name-error"
              class={fieldClass}
            />
            <p id="cf-name-error" class="mt-1 text-sm text-danger hidden" data-error-for="name">
              Please enter your name.
            </p>
          </div>

          <div>
            <label for="cf-email" class="block text-sm text-ink-dim mb-1.5"
              >Email</label
            >
            <input
              id="cf-email"
              type="email"
              name="email"
              required
              placeholder="you@example.com"
              aria-describedby="cf-email-error"
              class={fieldClass}
            />
            <p id="cf-email-error" class="mt-1 text-sm text-danger hidden" data-error-for="email">
              Please enter a valid email address.
            </p>
          </div>

          <div>
            <label for="cf-subject" class="block text-sm text-ink-dim mb-1.5"
              >Subject</label
            >
            <select
              id="cf-subject"
              name="subject"
              required
              aria-describedby="cf-subject-error"
              class={fieldClass}
            >
              <option value="" disabled selected>Select a subject</option>
              {
                contact.subjects.map((subject) => (
                  <option value={subject}>{subject}</option>
                ))
              }
            </select>
            <p id="cf-subject-error" class="mt-1 text-sm text-danger hidden" data-error-for="subject">
              Please choose a subject.
            </p>
          </div>

          <div>
            <label for="cf-message" class="block text-sm text-ink-dim mb-1.5"
              >Message</label
            >
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              placeholder="Tell me a bit about your project, goals, and timeline."
              aria-describedby="cf-message-error"
              class={fieldClass}></textarea>
            <p id="cf-message-error" class="mt-1 text-sm text-danger hidden" data-error-for="message">
              Please enter a message.
            </p>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-primary btn-full">
            Continue to Book a Call
            <Icon name="tabler:arrow-right" class="size-5" />
          </button>

          <!-- Submit failure message (network / gateway error) -->
          <p id="cf-form-error" role="alert" class="text-sm text-danger hidden text-center"></p>
        </form>

        <!-- SUCCESS (revealed on submit); the top step header updates to Step 2 of 2 -->
        <div id="success" class="hidden text-center">
          <div
            class="cf-check mx-auto flex size-16 items-center justify-center rounded-full bg-accent"
          >
            <Icon name="tabler:check" class="size-8 text-accent-ink" />
          </div>
          <p class="font-heading text-lg text-ink mt-4">
            Submitted successfully.
          </p>
          <p class="text-muted mt-1">You can now book a call.</p>

          {
            hasBooking && (
              <a
                class="btn btn-primary btn-full mt-6"
                href={call.bookingUrl}
                target="_blank"
                rel="noopener"
              >
                Book on {call.platform}
                <Icon name="tabler:calendar" class="size-5" />
              </a>
            )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Success checkmark pop-in. */
  #success:not(.hidden) .cf-check {
    animation: cf-pop 0.45s var(--ease-settle, cubic-bezier(0.16, 1, 0.3, 1))
      both;
  }
  @keyframes cf-pop {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    60% {
      opacity: 1;
      transform: scale(1.12);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #success:not(.hidden) .cf-check {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/contact-form.ts';
</script>
