---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

const CALENDAR_URL = "https://calendar.app.google/bo1H5XMtcQPor5Le6";

const methods = [
  {
    label: "Email",
    detail: SITE.email,
    icon: "simple-icons:gmail",
    href: `mailto:${SITE.email}`,
    note: "Reply within 24h",
  },
  {
    label: "LinkedIn",
    detail: "Connect with me",
    icon: "simple-icons:linkedin",
    href: SITE.social.linkedin,
    note: "Professional chat",
  },
  {
    label: "Schedule call",
    detail: "Book 30 minutes",
    icon: "simple-icons:googlecalendar",
    href: CALENDAR_URL,
    note: "Free intro chat",
  },
];

const socials = [
  { label: "GitHub", icon: "simple-icons:github", href: SITE.social.github },
  {
    label: "LinkedIn",
    icon: "simple-icons:linkedin",
    href: SITE.social.linkedin,
  },
];
---

<section
  id="contact"
  class="surface-deep relative overflow-hidden py-32 sm:py-44"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-[var(--font-crimson-pro)] font-black uppercase tracking-tighter text-pale-sage/4"
    style="font-size: clamp(160px, 24vw, 360px); line-height: 0.8; letter-spacing: -0.06em;"
    >hello.</span
  >

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Cinematic CTA block -->
    <div data-reveal-stagger class="border-y border-pale-sage/15 py-16">
      <p data-reveal class="eyebrow-rule text-sage-green">
        Chapter 06 · Let's build
      </p>
      <h2
        data-reveal
        class="display-serif mt-6 text-[clamp(56px,11vw,180px)] text-cream-white"
      >
        Have a project
        <span class="block italic font-light text-pale-sage mt-4">in mind?</span>
      </h2>
      <div
        data-reveal
        class="mt-10 flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end"
      >
        <p class="type-large-body max-w-xl text-pale-sage/80">
          Pick whichever channel works for you — email, LinkedIn, or grab a
          quiet 30 minutes on my calendar.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="group inline-flex items-center gap-4 bg-pale-sage px-8 py-5 text-charcoal-ink transition hover:bg-sage-green"
        >
          <span class="display-serif text-[clamp(20px,2vw,28px)]"
            >Start the conversation</span
          >
          <Icon
            name="tabler:arrow-up-right"
            class="size-6 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
          />
        </a>
      </div>
    </div>

    <!-- Contact methods — index row, no rounded cards -->
    <ul
      class="mt-12 grid gap-px border border-pale-sage/15 bg-pale-sage/15
         sm:grid-cols-1 md:grid-cols-3
         list-none m-0 p-0"
      data-reveal-stagger
    >
      {
        methods.map((m, i) => (
          <li data-reveal>
            <a
              href={m.href}
              target={m.href.startsWith("mailto") ? "_self" : "_blank"}
              rel="noopener noreferrer"
              class="group flex h-full min-h-[300px] flex-col justify-between
                 bg-charcoal-ink p-8 transition-all duration-300
                 hover:bg-slate-teal"
            >
              <div class="flex items-start justify-between">
                <span class="type-caption-12 tag-num text-sage-green">
                  0{i + 1}
                </span>

                <Icon
                  name={m.icon}
                  class="size-5 text-pale-sage/70 transition-colors duration-300
                     group-hover:text-sage-green"
                />
              </div>

              <div class="mt-12">
                <p class="type-caption-12 uppercase tracking-[0.18em] text-pale-sage/55">
                  {m.label}
                </p>

                <p class="display-serif mt-2 text-[clamp(22px,2vw,30px)] text-cream-white">
                  {m.detail}
                </p>

                <p class="type-caption mt-3 text-pale-sage/55">{m.note}</p>
              </div>

              <div class="mt-8 flex items-center justify-between border-t border-pale-sage/10 pt-4">
                <span class="type-caption-12 uppercase tracking-[0.18em] text-sage-green">
                  Open
                </span>

                <Icon
                  name="tabler:arrow-up-right"
                  class="size-4 text-sage-green transition-transform duration-300
                     group-hover:translate-x-1 group-hover:-translate-y-1"
                />
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Socials -->
    <div
      class="mt-16 flex flex-col items-center gap-6 sm:flex-row sm:justify-between"
      data-reveal
    >
      <p class="type-caption-12 uppercase tracking-[0.22em] text-pale-sage/55">
        Or follow along
      </p>
      <div class="flex items-center gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex size-11 items-center justify-center border border-pale-sage/15 text-pale-sage/75 transition hover:border-sage-green hover:bg-sage-green hover:text-charcoal-ink"
            >
              <Icon name={s.icon} class="size-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
