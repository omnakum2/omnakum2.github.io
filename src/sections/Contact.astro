---
import { Icon } from "astro-icon/components";
import { SITE } from "../consts";

const WHATSAPP_URL = "https://wa.me/0000000000";
const CALENDAR_URL = "https://cal.com/demo";

const methods = [
  {
    label: "Email",
    detail: SITE.email,
    icon: "simple-icons:gmail",
    href: `mailto:${SITE.email}`,
    note: "Reply within 24h",
  },
  {
    label: "LinkedIn",
    detail: "Connect with me",
    icon: "simple-icons:linkedin",
    href: SITE.social.linkedin,
    note: "Professional chat",
  },
  {
    label: "WhatsApp",
    detail: "Quick message",
    icon: "simple-icons:whatsapp",
    href: WHATSAPP_URL,
    note: "Fastest reply",
  },
  {
    label: "Schedule call",
    detail: "Book 30 minutes",
    icon: "simple-icons:googlecalendar",
    href: CALENDAR_URL,
    note: "Free intro chat",
  },
];

const socials = [
  { label: "GitHub", icon: "simple-icons:github", href: SITE.social.github },
  {
    label: "LinkedIn",
    icon: "simple-icons:linkedin",
    href: SITE.social.linkedin,
  }
];
---

<section
  id="contact"
  class="surface-deep relative overflow-hidden py-32 sm:py-44"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-[var(--font-crimson-pro)] font-black uppercase tracking-tighter"
    style="font-size: clamp(160px, 24vw, 360px); line-height: 0.8; color: rgba(202,210,197,0.04); letter-spacing: -0.06em;"
    >hello.</span
  >

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Cinematic CTA block -->
    <div
      data-reveal-stagger
      class="border-y border-[rgba(202,210,197,0.15)] py-16"
    >
      <p data-reveal class="eyebrow-rule text-[#84a98c]">
        Chapter 06 · Let's build
      </p>
      <h2
        data-reveal
        class="display-serif mt-6 text-[clamp(56px,11vw,180px)] text-[#f1f4ee]"
      >
        Have a project
        <span class="block italic font-light" style="color:#cad2c5;"
          >in mind?</span
        >
      </h2>
      <div
        data-reveal
        class="mt-10 flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end"
      >
        <p class="type-large-body max-w-xl text-[#cad2c5]/80">
          Pick whichever channel works for you — email, LinkedIn, WhatsApp, or
          grab a quiet 30 minutes on my calendar.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="group inline-flex items-center gap-4 bg-[#cad2c5] px-8 py-5 text-[#2f3e46] transition hover:bg-[#84a98c]"
        >
          <span class="display-serif text-[clamp(20px,2vw,28px)]"
            >Start the conversation</span
          >
          <Icon
            name="tabler:arrow-up-right"
            class="size-6 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
          />
        </a>
      </div>
    </div>

    <!-- Contact methods — index row, no rounded cards -->
    <ul
      class="mt-12 grid gap-px border border-[rgba(202,210,197,0.15)] bg-[rgba(202,210,197,0.15)] sm:grid-cols-2 lg:grid-cols-4 list-none m-0 p-0"
      data-reveal-stagger
    >
      {
        methods.map((m, i) => (
          <li data-reveal>
            <a
              href={m.href}
              target={m.href.startsWith("mailto") ? "_self" : "_blank"}
              rel="noopener noreferrer"
              class="group flex h-full flex-col justify-between bg-[#2f3e46] p-7 transition hover:bg-[#3f5d61]"
            >
              <div class="flex items-start justify-between">
                <span class="type-caption-12 tag-num text-[#84a98c]">
                  0{i + 1}
                </span>
                <Icon
                  name={m.icon}
                  class="size-5 text-[#cad2c5]/70 transition group-hover:text-[#84a98c]"
                />
              </div>
              <div class="mt-12">
                <p class="type-caption-12 uppercase tracking-[0.18em] text-[#cad2c5]/55">
                  {m.label}
                </p>
                <p class="display-serif mt-2 text-[clamp(20px,1.8vw,26px)] text-[#f1f4ee]">
                  {m.detail}
                </p>
                <p class="type-caption mt-3 text-[#cad2c5]/55">{m.note}</p>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-[rgba(202,210,197,0.10)] pt-4">
                <span class="type-caption-12 uppercase tracking-[0.18em] text-[#84a98c]">
                  Open →
                </span>
                <Icon
                  name="tabler:arrow-up-right"
                  class="size-4 text-[#84a98c] transition group-hover:translate-x-1 group-hover:-translate-y-1"
                />
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Socials -->
    <div
      class="mt-16 flex flex-col items-center gap-6 sm:flex-row sm:justify-between"
      data-reveal
    >
      <p class="type-caption-12 uppercase tracking-[0.22em] text-[#cad2c5]/55">
        Or follow along
      </p>
      <div class="flex items-center gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex size-11 items-center justify-center border border-[rgba(202,210,197,0.15)] text-[#cad2c5]/75 transition hover:border-[#84a98c] hover:bg-[#84a98c] hover:text-[#2f3e46]"
            >
              <Icon name={s.icon} class="size-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
