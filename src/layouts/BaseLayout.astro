---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildWebSiteLd, buildPersonLd } from '../lib/schema';
import { SITE } from '../consts';
import type { SeoConfig } from '../types/seo';

interface Props {
  seo: SeoConfig;
}
const { seo } = Astro.props;

const schemas = [
  buildWebSiteLd(),
  buildPersonLd({
    jobTitle: SITE.tagline,
    sameAs: [SITE.social.github, SITE.social.linkedin],
  }),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {/* Self-hosted fonts (configured in astro.config.ts). Astro inlines the
        @font-face CSS — no external request, no render-blocking. Preload the
        above-the-fold families (heading + body); the mono face loads on use. */}
    <Font cssVariable="--font-poppins" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-fira-code" />
    {/* Progressive enhancement: scroll-reveal needs JS, so without it show all
        [data-reveal] content instead of leaving it hidden at opacity 0. */}
    <noscript>
      <style is:inline>[data-reveal]{opacity:1!important;transform:none!important}</style>
    </noscript>
    <Seo seo={seo} />
    <SchemaOrg schemas={schemas} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/motion.ts';
      import '../scripts/tilt.ts';
    </script>
  </body>
</html>
